 generator client {
  provider = "prisma-client-js"
 engine   = "classic"
}

datasource db {
  provider = "postgresql"
}

 enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RecurrencePattern {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  YEARLY
}

enum TaskAccessRole {
  VIEWER
  EDITOR
  OWNER
}

model Task {
  id          String      @id @default(cuid())
  title       String
  description String?
  status      TaskStatus  @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?

  // Recurring task fields
  recurrence  RecurrencePattern?
  recurrenceEndDate DateTime?
  parentTaskId String?
  parentTask  Task?       @relation("childTasks", fields: [parentTaskId], references: [id])
  childTasks  Task[]      @relation("childTasks")

  // Relations
  tags        Tag[]
  sharedWith  TaskShare[]

  user        User        @relation("ownedTasks", fields: [userId], references: [id], onDelete: Cascade)
  userId      String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Tag {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("blue")

  tasks     Task[]
  user      User     @relation(fields: [userId], references: [id])
  userId    String

  createdAt DateTime @default(now())

  @@unique([name, userId])
}

model TaskShare {
  id        String   @id @default(cuid())

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    String

  sharedWith User    @relation("sharedTasks", fields: [sharedWithUserId], references: [id], onDelete: Cascade)
  sharedWithUserId String

  role      TaskAccessRole @default(VIEWER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taskId, sharedWithUserId])
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  ownedTasks    Task[]       @relation("ownedTasks")
  sharedTasks   TaskShare[]  @relation("sharedTasks")
  tags      Tag[]
}